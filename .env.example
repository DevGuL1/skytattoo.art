# Copy to .env and adjust for your environment.
# In development you can leave everything unset — SQLite + console email are used.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.skytattoo.art
DJANGO_CSRF_TRUSTED_ORIGINS=https://skytattoo.art

# --- Database (leave DB_ENGINE unset to use SQLite) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=skytattoo
# DB_USER=skytattoo
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Email (SMTP for production) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@skytattoo.art
CONTACT_NOTIFY_EMAIL=studio@skytattoo.art

# --- Google reCAPTCHA v2 (leave empty to disable) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
